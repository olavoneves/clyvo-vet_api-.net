# Copie para .env (ignorado pelo Git) e preencha. O docker compose lê este
# arquivo sozinho e recusa a subir se alguma variável faltar.

# Senha do usuário petflow no container oracle-clyvovet do core
# (APP_USER_PASSWORD no compose do clyvo-core).
ORACLE_APP_PASSWORD=

# A MESMA chave HMAC do core (JWT_SECRET no compose do clyvo-core). Chave
# diferente faz todo token legítimo virar 401.
JWT_SECRET=

# Senha do usuário root do Mongo das projeções. Só existe aqui.
MONGO_PASSWORD=
